{
  "name": "bailing",
  "productName": "百灵 Mynah",
  "version": "0.4.1",
  "description": "越用越懂你的 AI 语音输入 · 神鸟家族 · Windows",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test:polish": "node scripts/test-polish.js",
    "test:pipeline": "node scripts/test-pipeline.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "voice",
    "dictation",
    "speech-to-text",
    "asr",
    "input-method"
  ],
  "author": "神鸟家族",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "active-win": "^8.2.1",
    "dotenv": "^16.4.5",
    "pinyin-pro": "^3.28.2",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "cn.shenniao.bailing",
    "productName": "百灵Mynah",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!scripts/**",
      "!docs/**",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "data",
        "to": "data",
        "filter": [
          "terms.default.json"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**",
      "**/node_modules/@nut-tree-fork/**",
      "**/node_modules/active-win/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "百灵Mynah-安装包-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "百灵"
    }
  }
}
