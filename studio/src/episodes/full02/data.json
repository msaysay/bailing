 "drop": 33.873,
 "lines": [
  {
   "seg": "s1",
   "text": "兄弟们，我宣布",
   "start": 0.0,
   "end": 1.05
  },
  {
   "seg": "s1",
   "text": "短视频剪辑",
   "start": 1.08,
   "end": 1.83
  },
  {
   "seg": "s1",
   "text": "正式进入 AI 时代",
   "start": 1.86,
   "end": 2.97
  },
  {
   "seg": "s1",
   "text": "你现在看到的这条视频",
   "start": 3.0,
   "end": 4.41
  },
  {
   "seg": "s1",
   "text": "也是我用 AI 一键剪辑生成的",
   "start": 4.44,
   "end": 6.503
  },
  {
   "seg": "s2",
   "text": "你看到最后",
   "start": 6.533,
   "end": 7.408
  },
  {
   "seg": "s2",
   "text": "我会把这套工作流",
   "start": 7.438,
   "end": 8.728
  },
  {
   "seg": "s2",
   "text": "开源给大家",
   "start": 8.758,
   "end": 9.703
  },
  {
   "seg": "s3",
   "text": "有人问我说",
   "start": 9.733,
   "end": 10.608
  },
  {
   "seg": "s3",
   "text": "你做这事三个月之后",
   "start": 10.638,
   "end": 12.228
  },
  {
   "seg": "s3",
   "text": "剪映不就超过你了吗",
   "start": 12.258,
   "end": 13.47
  },
  {
   "seg": "s4a",
   "text": "但我想说的是",
   "start": 13.5,
   "end": 14.435
  },
  {
   "seg": "s4a",
   "text": "AI 时代",
   "start": 14.465,
   "end": 14.975
  },
  {
   "seg": "s4a",
   "text": "我们为什么还需要一个剪映",
   "start": 15.005,
   "end": 16.835
  },
  {
   "seg": "s4a",
   "text": "一个视频出来",
   "start": 16.865,
   "end": 17.675
  },
  {
   "seg": "s4a",
   "text": "交给 AI",
   "start": 17.705,
   "end": 18.335
  },
  {
   "seg": "s4a",
   "text": "让它自动剪出来",
   "start": 18.365,
   "end": 19.17
  },
  {
   "seg": "s4b",
   "text": "这不就搞定了吗",
   "start": 19.2,
   "end": 20.403
  },
  {
   "seg": "s5",
   "text": "除非你是特别专业的",
   "start": 20.433,
   "end": 22.37
  },
  {
   "seg": "s6",
   "text": "所以你现在看到的这条视频",
   "start": 22.4,
   "end": 24.065
  },
  {
   "seg": "s6",
   "text": "华丽的动效、包装",
   "start": 24.095,
   "end": 25.385
  },
  {
   "seg": "s6",
   "text": "都是我一句一句",
   "start": 25.415,
   "end": 26.885
  },
  {
   "seg": "s6",
   "text": "跟 AI 提要求",
   "start": 26.915,
   "end": 28.325
  },
  {
   "seg": "s6",
   "text": "它帮我做出来的",
   "start": 28.355,
   "end": 29.303
  },
  {
   "seg": "s7",
   "text": "而且我蒸馏了",
   "start": 29.333,
   "end": 30.298
  },
  {
   "seg": "s7",
   "text": "很多头部博主的剪辑风格",
   "start": 30.328,
   "end": 32.338
  },
  {
   "seg": "s7",
   "text": "而且在持续的扩充",
   "start": 32.368,
   "end": 33.843
  },
  {
   "seg": "s8",
   "text": "过去这样",
   "start": 33.873,
   "end": 34.685
  },
  {
   "seg": "s8",
   "text": "和这样的动效",
   "start": 34.715,
   "end": 35.825
  },
  {
   "seg": "s8",
   "text": "要很贵的剪辑师才能完成",
   "start": 35.855,
   "end": 37.577
  },
  {
   "seg": "s9",
   "text": "我的工作流里边",
   "start": 37.607,
   "end": 38.679
  },
  {
   "seg": "s9",
   "text": "全部给大家做出来了",
   "start": 38.709,
   "end": 40.11
  },
  {
   "seg": "s10",
   "text": "后面我还会持续更新",
   "start": 40.14,
   "end": 41.732
  },
  {
   "seg": "s10",
   "text": "数字人的自动化的工作流",
   "start": 41.762,
   "end": 43.352
  },
  {
   "seg": "s10",
   "text": "还有内容的创作工作台",
   "start": 43.382,
   "end": 45.443
  },
  {
   "seg": "s11",
   "text": "如果你也对这套工作流感兴趣",
   "start": 45.473,
   "end": 47.366
  },
  {
   "seg": "s11",
   "text": "你可以进粉丝群",
   "start": 47.396,
   "end": 48.326
  },
  {
   "seg": "s11",
   "text": "或者在评论区打「工作流」",
   "start": 48.356,
   "end": 50.077
  },
  {
   "seg": "s12",
   "text": "我是宁少",
   "start": 50.107,
   "end": 50.98
  },
  {
   "seg": "s12",
   "text": "陪伴 AI 时代的超级个体",
   "start": 51.01,
   "end": 52.743
  }
 ],
