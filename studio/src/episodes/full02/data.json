 "lines": [
  {
   "seg": "s1",
   "text": "兄弟们，我宣布",
   "start": 0.0,
   "end": 0.87
  },
  {
   "seg": "s1",
   "text": "短视频剪辑",
   "start": 0.9,
   "end": 1.65
  },
  {
   "seg": "s1",
   "text": "正式进入 AI 时代",
   "start": 1.68,
   "end": 2.67
  },
  {
   "seg": "s1",
   "text": "你现在看到的这条视频",
   "start": 2.7,
   "end": 4.097
  },
  {
   "seg": "s1",
   "text": "也是我用 AI 一键剪辑生成的",
   "start": 4.127,
   "end": 5.97
  },
  {
   "seg": "s2",
   "text": "你看到最后",
   "start": 6.0,
   "end": 6.658
  },
  {
   "seg": "s2",
   "text": "我会把这套工作流",
   "start": 6.688,
   "end": 7.978
  },
  {
   "seg": "s2",
   "text": "开源给大家",
   "start": 8.008,
   "end": 8.803
  },
  {
   "seg": "s3",
   "text": "有人问我说",
   "start": 8.833,
   "end": 9.537
  },
  {
   "seg": "s3",
   "text": "你做这事三个月之后",
   "start": 9.567,
   "end": 10.925
  },
  {
   "seg": "s3",
   "text": "剪映不就超过你了吗",
   "start": 10.955,
   "end": 12.137
  },
  {
   "seg": "s4a",
   "text": "但我想说的是",
   "start": 12.167,
   "end": 12.832
  },
  {
   "seg": "s4a",
   "text": "AI 时代",
   "start": 12.862,
   "end": 13.372
  },
  {
   "seg": "s4a",
   "text": "我们为什么还需要一个剪映",
   "start": 13.402,
   "end": 14.998
  },
  {
   "seg": "s4a",
   "text": "一个视频出来",
   "start": 15.028,
   "end": 15.637
  },
  {
   "seg": "s4a",
   "text": "交给 AI",
   "start": 15.667,
   "end": 16.232
  },
  {
   "seg": "s4a",
   "text": "让它自动剪出来",
   "start": 16.262,
   "end": 17.07
  },
  {
   "seg": "s4b",
   "text": "这不就搞定了吗",
   "start": 17.1,
   "end": 18.003
  },
  {
   "seg": "s6",
   "text": "所以你现在看到的这条视频",
   "start": 18.033,
   "end": 19.432
  },
  {
   "seg": "s6",
   "text": "华丽的动效、包装",
   "start": 19.462,
   "end": 20.67
  },
  {
   "seg": "s6",
   "text": "都是我一句一句",
   "start": 20.7,
   "end": 22.037
  },
  {
   "seg": "s6",
   "text": "跟 AI 提要求",
   "start": 22.067,
   "end": 23.325
  },
  {
   "seg": "s6",
   "text": "它帮我做出来的",
   "start": 23.355,
   "end": 24.137
  },
  {
   "seg": "s7",
   "text": "而且我蒸馏了",
   "start": 24.167,
   "end": 24.945
  },
  {
   "seg": "s7",
   "text": "很多头部博主的剪辑风格",
   "start": 24.975,
   "end": 26.837
  },
  {
   "seg": "s7",
   "text": "而且在持续的扩充",
   "start": 26.867,
   "end": 28.27
  },
  {
   "seg": "s8",
   "text": "过去这样",
   "start": 28.3,
   "end": 28.952
  },
  {
   "seg": "s8",
   "text": "和这样的动效",
   "start": 28.982,
   "end": 29.903
  },
  {
   "seg": "s8",
   "text": "要很贵的剪辑师才能完成",
   "start": 29.933,
   "end": 31.603
  },
  {
   "seg": "s9",
   "text": "我的工作流里边",
   "start": 31.633,
   "end": 32.572
  },
  {
   "seg": "s9",
   "text": "全部给大家做出来了",
   "start": 32.602,
   "end": 33.67
  },
  {
   "seg": "s10",
   "text": "后面我还会持续更新",
   "start": 33.7,
   "end": 35.062
  },
  {
   "seg": "s10",
   "text": "数字人的自动化的工作流",
   "start": 35.092,
   "end": 36.57
  },
  {
   "seg": "s10",
   "text": "还有内容的创作工作台",
   "start": 36.6,
   "end": 38.403
  },
  {
   "seg": "s11",
   "text": "如果你也对这套工作流感兴趣",
   "start": 38.433,
   "end": 40.18
  },
  {
   "seg": "s11",
   "text": "你可以进粉丝群",
   "start": 40.21,
   "end": 41.103
  },
  {
   "seg": "s11",
   "text": "或者在评论区打「工作流」",
   "start": 41.133,
   "end": 42.57
  },
  {
   "seg": "s12",
   "text": "我是宁少",
   "start": 42.6,
   "end": 43.17
  },
  {
   "seg": "s12",
   "text": "陪伴 AI 时代的超级个体",
   "start": 43.2,
   "end": 44.603
  }
 ],
